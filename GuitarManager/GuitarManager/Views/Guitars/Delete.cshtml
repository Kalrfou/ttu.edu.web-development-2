@model Guitar

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <h4 class="text-danger fw-bold">Confirm Deletion</h4>
        <p>
            Are you sure you want to delete the following guitar?
        </p>

        <ul class="list-group mb-3">
            <li class="list-group-item"><strong>Manufacturer:</strong> @Model.Manufacturer</li>
            <li class="list-group-item"><strong>Model:</strong> @Model.ModelName</li>
            <li class="list-group-item"><strong>Year:</strong> @Model.YearMade</li>
            <li class="list-group-item"><strong>Price:</strong> $@Model.Price</li>
        </ul>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="id" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</div>
