@model List<Guitar>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Guitar Inventory</h2>

    <a asp-action="Create" class="btn btn-primary">
        + Add New Guitar
    </a>
</div>

<div class="row">
    @foreach (var g in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">

                <img src="@g.ImagePath" class="card-img-top"
                     style="height:250px; object-fit:cover;"
                     alt="Guitar Image" />

                <div class="card-body">
                    <h5 class="card-title">@g.Manufacturer</h5>

                    <p class="card-text">
                        <strong>Model:</strong> @g.ModelName <br />
                        <strong>Year:</strong> @g.YearMade <br />
                        <strong>Price:</strong> $@g.Price
                    </p>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@g.id"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Details" asp-route-id="@g.id"
                       class="btn btn-info btn-sm">Details</a>

                    <a asp-action="Delete" asp-route-id="@g.id"
                       class="btn btn-danger btn-sm">Delete</a>
                </div>
            </div>
        </div>
    }
</div>
